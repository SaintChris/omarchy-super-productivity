hash -r
[[ $(command -v ssh) == "$FAKEBIN/ssh" ]] || fail "ssh is not the fake"
[[ $(command -v sp-launch) == "$FAKEBIN/sp-launch" ]] || fail "sp-launch is not the fake"
[[ $(command -v curl) == "$FAKEBIN/curl" ]] || fail "curl is not the fake"
printf 'fake-appimage-v1\n' >"$APP"
APP_SHA=$(sha256sum "$APP" | awk '{ print $1; exit }')
NEW_VER=${APP_SHA:0:16}
: >"$WORKDIR/empty-config"
# shellcheck source=scripts/sp-update
source "$SCRIPT"
trap finish EXIT

