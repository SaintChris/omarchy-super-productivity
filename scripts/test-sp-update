test_empty_fingerprint() {
  setup_case
  export FAKE_IDLE=yes
  printf '%s\n' '{"task":{"ids":[]},"project":{"ids":["p1"]},"globalConfig":{"sync":{"isEnabled":false}}}' \
    >"$DATA/backups/2026-11-04_000000.json"
  run_update
  assert_status 1
  assert_ntfy 4 "Update skipped. The data backup failed, so nothing was installed."
  assert_not_logged '^install '
  assert_current "$OLD_VERSION"
  assert_no_complete
}

test_prune() {
  local name
  setup_case
  for name in 01 02 03 04 05 06; do
    mkdir -p "$STATE/backups/2026-01-$name"
    : >"$STATE/backups/2026-01-$name/complete"
  done
  mkdir -p "$STATE/backups/incomplete"
  prune_backups
  [[ ! -d $STATE/backups/2026-01-01 ]] || fail "oldest backup was kept"
  [[ -d $STATE/backups/2026-01-02 ]] || fail "newer backup was pruned"
  [[ -d $STATE/backups/2026-01-06 ]] || fail "newest backup was pruned"
  [[ -d $STATE/backups/incomplete ]] || fail "incomplete backup was pruned"
  if shopt -q dotglob; then
    fail "dotglob leaked from prune"
  fi
}

test_hidden_process_installs() {
  local old bak
  setup_case
  export FAKE_IDLE=yes
  spawn_hidden_app
  old=$SPAWNED
  run_update
  assert_status 0
  assert_current "$NEW_VER"
  [[ ! -d /proc/$old ]] || fail "rewritten command line was left running"
  bak=$(one_backup)
  grep -qx 'mode exact' "$bak/fingerprint" || fail "before-state was not an API snapshot"
  if grep -q '^mode superset$' "$bak/fingerprint"; then
    fail "before-state came from the JSON backup"
  fi
  grep -qx 'task t1' "$bak/fingerprint" || fail "fingerprint missed t1"
  grep -qx 'task t2' "$bak/fingerprint" || fail "fingerprint missed t2"
  assert_marker after
  assert_ntfy 3 "Installed $COMMIT."
}

test_hidden_backup_disagrees() {
  local old
  setup_case
  export FAKE_IDLE=yes
  printf '%s\n' '{"task":{"ids":["t1","t2","t3"]},"project":{"ids":["p1","p2"]}}' \
    >"$DATA/backups/2026-11-04_000000.json"
  spawn_hidden_app
  old=$SPAWNED
  run_update
  assert_status 1
  assert_ntfy 5 "Update skipped. The app is missing projects or tasks that the latest backup lists, so nothing was installed."
  assert_messages 1
  assert_not_logged '^install '
  assert_current "$OLD_VERSION"
  [[ -d /proc/$old ]] || fail "app was quit when the backup disagreed"
  assert_marker before
  assert_sync_kept
  assert_no_complete
}

