test_rollback_readback_fails() {
  setup_case
  export FAKE_IDLE=yes
  export FAKE_DEGRADE_AFTER=1
  export FAKE_TASK_COUNT_FILE=$CASE/task-reads
  printf '0\n' >"$FAKE_TASK_COUNT_FILE"
  run_update
  assert_status 1
  assert_log "^install $NEW_VER$"
  assert_current "$OLD_VERSION"
  assert_marker before
  assert_sync_kept
  [[ ! -e $DATA/Migration ]] || fail "migration file survived rollback"
  cmp -s "$CASE/json-orig" "$DATA/backups/2026-11-04_000000.json" || fail "json file matches but that is not the data check"
  assert_ntfy 5 "Update failed. The previous version was put back, but the running data does not match the backup."
  if grep -q 'data backup was restored' "$SINK"; then
    fail "restore was reported without an API match"
  fi
  assert_messages 1
}

test_backup_restore() {
  local dest
  setup_case
  dest=$STATE/backups/manual
  backup_profile "$DATA" "$dest"
  [[ ! -e $dest/profile/Cache ]] || fail "cache copied"
  [[ ! -e $dest/profile/Code\ Cache ]] || fail "code cache copied"
  [[ -f $dest/profile/.keep ]] || fail "dotfile missed"
  cmp -s "$CASE/sync-orig" "$dest/profile/sync-marker" || fail "sync marker bytes differ"
  cmp -s "$CASE/json-orig" "$dest/app-backup.json" || fail "json copy differs"
  if shopt -q dotglob || shopt -q nullglob; then
    fail "backup leaked a shell glob option"
  fi
  printf 'changed\n' >"$DATA/profile-marker"
  mkdir -p "$DATA/Migration"
  printf 'new\n' >"$DATA/Migration/state"
  printf 'extra\n' >"$DATA/extra"
  restore_profile "$dest" "$DATA"
  assert_marker before
  [[ ! -e $DATA/Migration ]] || fail "restore left a file the backup does not have"
  [[ ! -e $DATA/extra ]] || fail "restore left an extra file"
  [[ -f $DATA/Cache/junk ]] || fail "restore removed cache"
  [[ -f $DATA/Code\ Cache/x ]] || fail "restore removed code cache"
  [[ -f $DATA/.keep ]] || fail "restore dropped a dotfile"
  assert_sync_kept
  cmp -s "$CASE/json-orig" "$DATA/backups/2026-11-04_000000.json" || fail "restored json differs"
  if shopt -q dotglob; then
    fail "dotglob leaked from restore"
  fi
  rm -f "$DATA/backups/"*.json
  if backup_profile "$DATA" "$STATE/backups/nojson"; then
    fail "backup without a json export should fail"
  fi
  rm -rf "$DATA/backups" "$DATA/IndexedDB"
  if backup_profile "$DATA" "$STATE/backups/nodata"; then
    fail "backup without profile data should fail"
  fi
}

